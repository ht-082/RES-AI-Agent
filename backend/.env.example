# =====================================================================
# 재생E AI Agent — backend 환경변수 템플릿
#
# 사용법: 이 파일을 backend/.env 로 복사한 뒤 값을 채운다.
#   cp backend/.env.example backend/.env
#
# 주의: docker-compose.yml 은 프로젝트 루트의 .env 를 읽는다(루트 .env.example 참고).
#       컨테이너 환경변수가 backend/.env 보다 우선하므로, 두 파일의
#       LLM_API_BASE / LLM_API_KEY 는 같은 값으로 맞춰 둘 것.
# =====================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_DB=re_agent
POSTGRES_USER=re_user
POSTGRES_PASSWORD=

# ── Django ────────────────────────────────────────────────────────────
# SECRET_KEY: 필수. 비어 있으면 기동 시 예외로 중단된다(기본값 없음).
# 생성: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# 로컬 개발 중에만 True. 배포 시 False (예외 화면에 소스·환경변수가 노출된다)
DJANGO_DEBUG=True

# '*' 금지. 접속에 쓰는 호스트만 나열한다. 운영 모드에서 '*'면 기동이 중단된다.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# 쿠키 인증을 쓰므로 출처 화이트리스트가 유일한 방어선이다.
# CSRF 신뢰 출처로도 함께 쓰인다.
DJANGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── LLM (답변 생성) ───────────────────────────────────────────────────
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=

# ── Qdrant / Redis ────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0

# ── 임베딩 ────────────────────────────────────────────────────────────
# EMBEDDING_DEVICE: cpu | cuda | api
#   cpu  — 로컬 BGE-M3. dense + sparse 를 모두 얻어 하이브리드 검색이 동작한다 (권장)
#   api  — 외부 임베딩 API. sparse 를 못 받아 dense 단독 검색이 된다
# ⚠ docker-compose.yml 이 EMBEDDING_DEVICE=cpu 를 컨테이너에 직접 주입하므로
#   이 값은 무시된다. 바꾸려면 docker-compose.yml 을 수정할 것.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_API_BASE=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
