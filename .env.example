# =====================================================================
# 재생E AI Agent — 루트 환경변수 템플릿 (docker-compose 전용)
#
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 채운다.
#   cp .env.example .env
#
# docker-compose.yml 이 ${...} 치환에 사용한다.
# Django 설정값(SECRET_KEY·ALLOWED_HOSTS·CORS 등)은 backend/.env 에 둔다.
# =====================================================================

# Postgres 컨테이너 초기화 및 DATABASE_URL 조립에 사용
POSTGRES_DB=re_agent
POSTGRES_USER=re_user
POSTGRES_PASSWORD=

# 컨테이너에 주입되는 LLM 설정 — backend/.env 의 같은 항목보다 우선한다
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
